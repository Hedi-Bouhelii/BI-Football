                        <arrayElement
                          dataType="System.String"><![CDATA[using System;
using System.Data;
using System.Globalization;                       // ← added
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    // (PreExecute / PostExecute methods may be here; leave them)

    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        string id = Row.compid_IsNull ? "" : Row.compid;
        switch (id)
        {
            case "GB1": Row.competitionname = "Premier League"; return;
            case "ES1": Row.competitionname = "LaLiga"; return;
            case "IT1": Row.competitionname = "Serie A"; return;
            case "L1": Row.competitionname = "Bundesliga"; return;
            case "FR1": Row.competitionname = "Ligue 1"; return;
        }
        if (Row.slugspaced_IsNull)
            Row.competitionname_IsNull = true;
        else
            Row.competitionname = CultureInfo.InvariantCulture.TextInfo.ToTitleCase(Row.slugspaced.ToLower());
    }
}]]></arrayElement>
